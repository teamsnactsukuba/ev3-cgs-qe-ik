// generate-e.rr
// Generating a list of the degree of elements in the CGS w.r.t. certain variables
// Akira Terui, Team SNAC Tsukuba, October 2024

// E containts the degrees
// [deg(g0,s_7), deg(g1,c_7), deg(g2,s_4), deg(g3,c_4), deg(g4,s_1), deg(g5,c_1)]
// for each CGS in B.rr;

load("B.rr")$

L = length(B)$
Vlist = [c_1,s_1,c_4,s_4,c_7,s_7]$
E = []$

for (I = 0; I < L; I++) {
    F2 = B[I];
    L2 = length(B[I])$
    Vlist2 = reverse(Vlist)$
    Dlist = [];
    Tlist = [];
    for (J = 0; J < L2; J++) {
        Dlist = cons(deg(F2[J], Vlist2[J]), Dlist);
    }
    E = cons(reverse(Dlist), E);
}
E = reverse(E)$

// output("E.rr")$
// print("E = ")$
// E;
// print("$")$
// print("end$")$
// output()$

end$
