// generate-b.rr
// Generating a CGS after subsituting s_7^2 with 1 - c_7^2 in certain basis
// Akira Terui, Team SNAC Tsukuba, October 2024

// G and H are the results of the following computations on Risa/Asir, respectively:
// G: ../../preprocessing-steps/cgs/rational/cgs-F-input-rational.rr
// H: ../../preprocessing-steps/cgs/rational/cgs-H-input-rational.rr

// F corresponds to the inverse kinematic problem in 6 variables where the end effector is located in generic position;
// H corresponds to the inverse kinematic problem in 6 variables where the end effector is located on the z axis;

// B contains Comprehensive Groebner System whose partition is nonempty in R^3, where 
// B = [G[0][1],G[8][1],G[10][1],G[18][1],G[25][1],G[31][1],G[33][1],H[2][1]];
// Note that the corresponding partition is defined as A in partition.py; 

// The basis in G[18][1],G[25][1],G[31][1] are modified as follows:
// these basis contains s_7^2+c_7^2-1 which is redundant, thus make it s_7^2=1-c_7^2 and substitute s_7 in g1 with s_7^2=1-c_7^2;


load("oh_base.rr")$

G = bload("../../preprocessing-steps/cgs/rational/G.dat")$
GG = map(oh_base.nth, G, 1)$ // Extract the Groebner basis
GGV = ltov(GG)$
Gpart = map(oh_base.nth, G, 1)$ // Extract the partition

H = bload("../../preprocessing-steps/cgs/rational/H.dat")$
HH = map(oh_base.nth, H, 1)$
HHV = ltov(HH)$

L = [18,25,31]$ // Replace the polynomials GGV[L[J]]

// Re-arrange G with substituting variables
for (J = 0; J < length(L); J++) {
    I = L[J]$

    // Extract the I-th G-basis
    CurrentGGV = GGV[I]$
    // print(CurrentGGV);
    CurrentGGV = oh_base.remove_nth(CurrentGGV, 2)$
    CurrentGGVV = ltov(CurrentGGV)$
    
    // Extract the 2nd polynomial
    CurrentGGVVpoly = CurrentGGVV[1]$
    CurrentGGVVcoef = coef(CurrentGGVVpoly, 2, s_7)$
    
    // Substitute the term of s_7^2 
    NewGGVVpoly = CurrentGGVVpoly - CurrentGGVVcoef * s_7^2 + CurrentGGVVcoef * (1 - c_7^2)$
    
    // Construct the I-th G-basis
    CurrentGGVV[1] = NewGGVVpoly$

    // Construct G
    CurrentGGV = vtol(CurrentGGVV)$
    GGV[I] = CurrentGGV$
    // print(CurrentGGV);
}

// Output G[I] and H[J] for I = [0,8,10,18,25,31,33] and J = [1]

LG = [0,8,10,18,25,31,33]$
BL = []$

for (J = 0; J < length(LG); J++) {
    I = LG[J]$
    BL = cons(GGV[I], BL)$
}

BL = cons(HHV[1], BL)$
BL = reverse(BL)$

// output("B.rr")$
// print("B = ")$
// BL;
// print("$")$
// print("end$")$
// output()$

end$
