/*-------------------------------------------------------------*/
/* 	intersection の計算 */
/*-------------------------------------------------------------*/
/*zero checkあり*/

def inter_para(P1,P2,Para){

V1=append(P1[0],P2[0]);
PG1=variety_refine(V1,Para);
	if(PG1==[]){
		PG1=[0];
	}

if(type(PG1[0])==1){
	return 0;
	}
PV1=P1[1];
PV2=P2[1];

if((PV1[0]==1) && (PV2[0]==1)){
	return [PG1,[1]];
}
if(PV1[0]==1){
V2=append(P1[0],P2[1]);
PG2=variety_refine(V2,Para);
Pz=zero_check([PG1,PG2]);
	if(Pz==0){
		return [PG1,PG2];
 	}else{
		return 0;}
}

if(PV2[0]==1){
V3=append(P1[1],P2[0]);
PG3=variety_refine(V3,Para);
Pz=zero_check([PG1,PG3]);
	if(Pz==0){
		return [PG1,PG3];
 	}else{
		return 0;}
}

if(P2[0][0]==0){
	PP2=[];
}else{
	PP2=P2[0];}
if(P1[0][0]==0){
	PP1=[];
}else{
	PP1=P1[0];}

PV1=append(PV1,PP2);
PV2=append(PV2,PP1);

L=[];
while(PV1!=[]){
	S1=car(PV1);
	PV1=cdr(PV1);
	CC=PV2;
	while(CC!=[]){
		C1=car(CC);
		CC=cdr(CC);
		L=cons(C1*S1,L);
	}
}
PG4=variety_refine(L,Para);
Pz=zero_check([PG1,PG4]);
if(Pz==0){
	return [PG1,PG4];
 	}else{
		return 0;}
}


/*-------------------------------------------------------------*/
/* 	supportの引き算 */
/*-------------------------------------------------------------*/
/*zero check あり*/
/*[0]と[1]のときだめ。改良しないと。2月3日*/


def dele_para(P1,P2,Para){
L=[];
PV1=P1[1];
PW=append(P1[0],P2[0]);
SP=PV1;
Vr1=variety_refine(vari_prod(SP,PW),Para);
if(zero_check([P1[0],Vr1])==0){
L=cons([P1[0],Vr1],L);
}
Vr2=variety_refine(append(P1[0],P2[1]),Para);
Vr3=variety_refine(append(P1[1],P2[1]),Para);
if(zero_check([Vr2,Vr3])==0){
L=cons([Vr2,Vr3],L);
}

return L;
}

/**********動作確認用***************/

def testdele_para(P1,P2,Para){
L=[];
PV1=P1[1];
PW=append(P1[0],P2[0]);
SP=PV1;
L=cons([P1[0],variety_refine(vari_prod(SP,PW),Para)],L);
print(L);
L=cons([variety_refine(append(P1[0],P2[1]),Para),variety_refine(append(P1[1],P2[1]),Para)],L);
return L;
}


/*--------------------*/
/*   sort 関係の関数  */
/*--------------------*/
/*left small, right big*/

def sort_degmini(H,Jun){

if(length(H)==1) return(H);
if(H==[]) return(H);
dp_ord(Jun);
H1=car(H);
H0=dp_ht(H1);
H=cdr(H);
L=[];
S=[];
while(H!=[]){
	H2=car(H);
	H=cdr(H);
	if(H0>dp_ht(H2)){
		S=cons(H2,S);
	}else{
		L=cons(H2,L);
}}
S=sort_degmini(S,Jun);
L=sort_degmini(L,Jun);
Sor=append(S,cons(H1,L));
return(Sor);
}


