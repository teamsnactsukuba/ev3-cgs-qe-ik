// generate-G3.rr
// Generating a CGS and their partitions re-arranged
// Akira Terui, Team SNAC Tsukuba, August 2025

// Reading a CGS G2-new:
// G2-new.dat

// For the Gröbner basis in every partition, re-arrange necessary elements

load("oh_base.rr")$

def sort_list(L, Key) {

    // Sorting a list
    // Inputs: L - the list to be sorted
    //         Key - the list of 0,1,...,n-1 indicating the sorting order
    // Outputs: L2 - the sorted list

    L2 = [];
    for (I = 0; I < length(Key); I++) {
        L2 = cons(L[Key[I]], L2)$
    }
    return reverse(L2);
}

def generate_G2_2 (G, SortOrder) {

    GA =  map(oh_base.nth, G, 0)$ // segments
    GB =  map(oh_base.nth, G, 1)$ // Gröbner bases
    GBV = ltov(GB)$

    while (SortOrder != []) {
        Head = car(SortOrder)$
        I = car(Head)$
        Key = cadr(Head)$
        SortOrder = cdr(SortOrder)$

        GBV[I] = sort_list(GBV[I], Key)$
    }

    L = [];
    for (I = 0; I < length(G); I++) {
        L = cons([GA[I], vtol(GBV[I])], L)$
    }

    return reverse(L)$

}


GFile = "G2-new.dat"$
G2new = bload(GFile)$

SortOrder = [
[1, [1,3,5,6,7,8]],
[8, [0,1,3,4,5,6]],
[9, [0,1,3,4,5,6]],
[12,[1,3,5,6,7,8]],
[13,[1,3,5,6,7,8]],
[14,[1,3,5,6,7,8]],
[16,[1,2,3,4,5,6]],
[18,[1,2,3,4,5,6]],
[19,[1,2,3,4,5,6]],
[20,[1,2,3,4,5,6]],
[33,[1,2,3,4,5,6]]
]
$

G2_2 = generate_G2_2(G2new, SortOrder)$

if (OUTPUT) {
    bsave(G2_2, "G2-2.dat")$
} else {}

G2aFile = "G2-new-a.dat"$
G2newa = bload(G2aFile)$

G2_2a = generate_G2_2(G2newa, SortOrder)$

if (OUTPUT) {
    bsave(G2_2a, "G2-2-a.dat")$
} else {}

end$
