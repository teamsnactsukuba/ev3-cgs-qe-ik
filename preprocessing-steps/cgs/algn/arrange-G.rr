load("oh_sets.rr")$

def left_variables(G, Vlist) {
    // Input: G: a list of polynomials
    //        Vlist: a list of variables
    // Output: a list of variables in G that are not in Vlist

    L = length(G);
    // Vlist1 = [c_1,s_1,c_4,s_4,c_7,s_7]$
    Vlist2 = []$
    for (I = 0; I < L; I++) {
        LM = p_terms(G[I], Vlist, 2)[0];
        LV = var(LM)$
        Vlist2 = cons(LV, Vlist2);
    }
    return sets_setMinus(Vlist, Vlist2);
}

G2r = bload("G2-reverse.dat")$
// G2rl = ltov(map(ltov, G2r))$

L1 = [0,1,6,8,9,11,12,13,14,16,18,19,20,33,36,37,38,39]$
// L1 = [36]$

G2new = []$
Vlist = [c_1,s_1,c_4,s_4,c_7,s_7]$

while (L1 != []) {
    I = car(L1)$
    L1 = cdr(L1)$
    // printf("I = %a\n", I);
    S = G2r[I]$
    V = S[0]$
    G = S[1]$
    if (G[0] == a^2-2) {
        G = cdr(G)$
    }
    G = subst(G, a, 2^(1/2))$
    if (left_variables(G, Vlist) != []) {
        G = reverse(G)$
        if (car(G) == c_1^2+s_1^2-1) {
            G = cdr(G)$
        } else {
            G = cons(c_1^2+s_1^2-1, G)$
        }
        G = reverse(G)$
    }
    S2 = [S,G]$
    G2new = cons(S2, G2new)$
}

G2new = reverse(G2new)$

if (OUTPUT) {
    bsave(G2new, "G2-new.dat")$
} else {}

end$