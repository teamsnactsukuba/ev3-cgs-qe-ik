load("KapuCGS.rr");
load("inconsistent.rr");

// Computing CGS: F with lex order

// F = [-112*c_1*c_4*s_7+16*c_1*c_4-112*c_1*c_7*s_4-136*c_1*s_4+44*2^(1/2)*c_1-x,
//     -112*c_4*s_1*s_7+16*c_4*s_1-112*c_7*s_1*s_4-136*s_1*s_4+44*2^(1/2)*s_1-y,
//     112*c_4*c_7+136*c_4-112*s_4*s_7+16*s_4+44*2^(1/2)+104-z,s_1^2+c_1^2-1,
//     s_4^2+c_4^2-1,s_7^2+c_7^2-1]$

// Representing the square root of 2 as an algebraic number 'a'

F0 = -112*c_1*c_4*s_7+16*c_1*c_4-112*c_1*c_7*s_4-136*c_1*s_4+44*a*c_1-x$
F1 = -112*c_4*s_1*s_7+16*c_4*s_1-112*c_7*s_1*s_4-136*s_1*s_4+44*a*s_1-y$
F2 = 112*c_4*c_7+136*c_4-112*s_4*s_7+16*s_4+44*a+104-z$
F3 = s_1^2+c_1^2-1$
F4 = s_4^2+c_4^2-1$
F5 = s_7^2+c_7^2-1$
F6 = a^2-2$ // The minimum polynomial of 2^(1/2)

F = ltov([F0, F1, F2, F3, F4, F5, F6])$
F = subst(F,c_1,1/a,s_1,1/a)$

F[0] = red(F[0]*a)$
F[1] = red(F[1]*a^5)$
F = [F[0], F[1], F[2], F[4], F[5], F[6]]$ // Reordering to match the original order

Plist = [x,y,z]$
Vlist = [c_1,s_1,c_4,s_4,c_7,s_7,a]$
PVlist = append(Plist, Vlist)$
VPlist = append(Vlist, Plist)$

if (OUTPUT == 1) {
    H2 = kcgs_main(F, [x,y,z], [c_4,s_4,c_7,s_7,a], 2)$
    bsave(H2, "H2.dat")$
}

end$
