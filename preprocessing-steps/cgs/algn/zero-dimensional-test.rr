load("oh_sets.rr")$

def zerodimtest (S, Vlist) {

    // Zero-dimensional test (Algorithm 2) for a segment
    // Input:
    // S: a segment
    // Vlist: a list of variables

    // L1 = [0,1,6,8,9,11,12,13,14,16,18,19,20,33,36,37,38,39]$
    // Vlist = [c_1,s_1,c_4,s_4,c_7,s_7]$

    // print("The leading monomial in each polynomial in a Groebner basis of the segment:")$
    // print('')$

    F2 = S[1];
    L2 = length(F2);
    // printf("I = %a:\n", I);
    Vlist3 = [];
    for (J = 0; J < L2; J++) {
        LM = p_terms(F2[J], Vlist, 2)[0];
        LV = var(LM)$
        Vlist3 = cons(LV, Vlist3);
        printf("g_%a: %a\n", J, LM);
    }
    print("Variables which do not appear in the leading monomial in the Groebner basis:")$
    print(sets_setMinus(Vlist, Vlist3))$
    print('');
    
}

def zerodimtest_segs(L, Index, Vlist) {

    // Zero-dimensional test for segments in L
    // Input:
    // L: a Comprehensive Gröbner System
    // Index: a list of segment indices
    // Vlist: a list of variables

    while (Index != []) {
        I = car(Index);
        Index = cdr(Index);

        printf("Segment %a:\n", I);
        zerodimtest(L[I], Vlist);
    }
}

end$
