Cell["\<\
This basis is in the shape form, thus the monomial basis of the residue class \
ring R[c1,s1,c4,s4,c7,s7]/<G0[[1]], G0[[2]], G0[[3]], G0[[4]], G0[[5]], \
G0[[6]]> = {1, s7, s7^2, s7^3}
Leg B = {1, s7, s7^2, s7^3}\
