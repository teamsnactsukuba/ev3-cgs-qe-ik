ord([a,t,x,y,z])$ // set a as the main variable
L = [0,1,6,8,9,11,12,13,14,16,18,19,20,33,36,37,38,39]$
C = []$

while (L != []) {
    I = car(L)$
    L = cdr(L)$
    HFilename = "H-" + rtostr(I) + ".dat";
    H = bload(HFilename)$
    printf("I = %a\n", I);
    Hp = red(H*dn(H))$ // multiply the denominator
    Hpa = srem(Hp, a^2-2, a)$ // calculate the remainder of Hp divided by a^2-2 which corresponds a = 2^(1/2)
    Hpa = subst(Hpa, a, 2^(1/2))$ // substitute a = 2^(1/2)
    C = cons(Hpa, C)$ // add to C
}

C = reverse(C)$

if (OUTPUT) {
    PFilename = "C.dat";
    bsave(C, PFilename)$
} else {
}


end$